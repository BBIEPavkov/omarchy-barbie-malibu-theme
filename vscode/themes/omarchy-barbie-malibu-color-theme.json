    "breadcrumb.activeSelectionForeground": "#E0218A",
    "breadcrumb.background": "#FFDCEB",
    "breadcrumb.focusForeground": "#D81B7A",
    "breadcrumb.foreground": "#7A1550",
    "breadcrumbPicker.background": "#FFC6DD",
    "button.background": "#E0218A50",
    "button.foreground": "#4A0B30",
    "contrastBorder": "#E0218A40",
    "diffEditor.insertedTextBackground": "#1F9A7330",
    "diffEditor.removedTextBackground": "#D6115E30",
    "dropdown.background": "#FFC6DD",
    "dropdown.border": "#E0218A10",
    "editor.background": "#FFD5E7",
    "editor.findMatchBackground": "#E0218A40",
    "editor.findMatchBorder": "#E0218A",
    "editor.findMatchHighlightBackground": "#D81B7A40",
    "editor.foreground": "#7A1550",
